# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
BOT_TOKEN=123456789:replace_me
# Comma separated Telegram user IDs with admin access (use /myid in the bot)
ADMIN_IDS=123456789
# Public username of support account without @ (optional)
SUPPORT_CONTACT=masterly_support

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/masterly
DB_ECHO=false
# Create missing tables on startup (convenient for the first run / Render).
# For production you can disable it and run: alembic upgrade head
AUTO_CREATE_SCHEMA=true

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
DEFAULT_LANGUAGE=uz
COMMISSION_PERCENT=15
MIN_WITHDRAWAL=50000
MASTER_ACCEPT_TIMEOUT_MINUTES=15
PAYMENT_TIMEOUT_MINUTES=120
TIMEZONE=Asia/Tashkent

# ---------------------------------------------------------------------------
# Web server / webhooks
# ---------------------------------------------------------------------------
PORT=8080
# Public HTTPS base URL of this service (Render URL). Empty = polling mode.
PUBLIC_BASE_URL=http://localhost:8080
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-webhook-secret
# Telegram sends updates to {WEBHOOK_BASE_URL}/telegram/webhook/{WEBHOOK_SECRET}

# ---------------------------------------------------------------------------
# Payments
# mock  - local signed confirmation page, no merchant account required (demo)
# click - Click SHOP API (merchant credentials required)
# payme - Payme Merchant API (merchant credentials required)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Used to derive the card encryption key (Fernet) and to sign mock payments.
# Use a long random value in production and never commit it.
SECRET_KEY=change-me-to-a-long-random-string
# Optional explicit Fernet key (urlsafe base64, 32 bytes). If empty, derived
# from SECRET_KEY.
CARD_ENCRYPTION_KEY=
LOG_LEVEL=INFO
RATE_LIMIT_SECONDS=0.4
